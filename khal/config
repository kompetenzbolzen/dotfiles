[calendars]

[[contacts]]
path = ~/.local/share/vdirsyncer/carddav/*
type = discover

[[calendar]]
path = ~/.local/share/vdirsyncer/caldav/*
type = discover

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M

[default]
default_calendar = jonas
