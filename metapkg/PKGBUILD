pkgname=dotfile-meta
pkgver=1790284247
pkgrel=1
pkgdesc="dotfile sway meta package"
arch=('any')
url="https://git.jonasgunz.de/dotfiles"
license=('NONE')
makedepends=()

pkgver() {
	# NOTE use UNIX time as version
	date +%s
}

package() {
	IFS=$'\n' depends=( "$(dotfile list_installed_deps)" )
}
